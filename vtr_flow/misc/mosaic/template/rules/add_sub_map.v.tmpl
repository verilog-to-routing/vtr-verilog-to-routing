// add_sub_map.v. generated by vtr_arch_rules from @ARCH_NAME@
// this map binds inferred $add and $sub to the arch carry-chain adder under
// classic adder/subtractor map. it must run before alumacc because alumacc
// folds $add chains into one $macc and the carry chain never sees them, which
// tanks fmax on add-heavy designs. only widths above HARD_ADDER_THRESHOLD go
// hard so abc can still optimize across narrower ops because hard adders are
// black boxes. compares stay soft on purpose and there is no $alu to adder map
// after alumacc because that path was a net qor loss. cin is only reachable
// through the dedicated carry link rather than general routing, so a constant
// cannot drive cin[0] directly; the dummy adder below makes majority(ci ci 0)=ci
// and feeds carry[0] that way.

// addition module
module \$add (A, B, Y);
    parameter A_SIGNED = 0;
    parameter B_SIGNED = 0;
    parameter A_WIDTH  = 1;
    parameter B_WIDTH  = 1;
    parameter Y_WIDTH  = 1;

    // widths at or below HARD_ADDER_THRESHOLD stay soft so abc can optimize.
    localparam HARD_ADDER_THRESHOLD = @HARD_ADDER_THRESHOLD@;

    input  [A_WIDTH-1:0] A;
    input  [B_WIDTH-1:0] B;
    output [Y_WIDTH-1:0] Y;

    wire _TECHMAP_FAIL_ = (Y_WIDTH <= HARD_ADDER_THRESHOLD);

    // signed and unsigned share the same chain once both sides are extended.
    wire [Y_WIDTH-1:0] aa;
    wire [Y_WIDTH-1:0] bb;
    generate
        if (A_SIGNED)
            assign aa = {{(Y_WIDTH - A_WIDTH){A[A_WIDTH-1]}}, A};
        else
            assign aa = {{(Y_WIDTH - A_WIDTH){1'b0}}, A};
        if (B_SIGNED)
            assign bb = {{(Y_WIDTH - B_WIDTH){B[B_WIDTH-1]}}, B};
        else
            assign bb = {{(Y_WIDTH - B_WIDTH){1'b0}}, B};
    endgenerate

    // boot with ci=0 so majority(0 0 0)=0 and carry[0] starts clear.
    wire boot_cout;
    wire boot_sumout;
    @ADDER_MODEL@ _boot (
        .a(1'b0), .b(1'b0), .cin(1'b0),
        .sumout(boot_sumout), .cout(boot_cout)
    );

    wire [Y_WIDTH:0] carry;
    assign carry[0] = boot_cout;

    genvar i;
    generate
        for (i = 0; i < Y_WIDTH; i = i + 1) begin : faChain
            @ADDER_MODEL@ _adder (
                .a     (aa[i]),
                .b     (bb[i]),
                .cin   (carry[i]),
                .sumout(Y[i]),
                .cout  (carry[i+1])
            );
        end
    endgenerate

endmodule

// subtraction module
module \$sub (A, B, Y);
    parameter A_SIGNED = 0;
    parameter B_SIGNED = 0;
    parameter A_WIDTH  = 1;
    parameter B_WIDTH  = 1;
    parameter Y_WIDTH  = 1;

    // use the same threshold as $add so a-b and a+b agree on what stays soft.
    localparam HARD_ADDER_THRESHOLD = @HARD_ADDER_THRESHOLD@;

    input  [A_WIDTH-1:0] A;
    input  [B_WIDTH-1:0] B;
    output [Y_WIDTH-1:0] Y;

    wire _TECHMAP_FAIL_ = (Y_WIDTH <= HARD_ADDER_THRESHOLD);

    wire [Y_WIDTH-1:0] aa;
    wire [Y_WIDTH-1:0] bb;
    generate
        if (A_SIGNED)
            assign aa = {{(Y_WIDTH - A_WIDTH){A[A_WIDTH-1]}}, A};
        else
            assign aa = {{(Y_WIDTH - A_WIDTH){1'b0}}, A};
        if (B_SIGNED)
            assign bb = {{(Y_WIDTH - B_WIDTH){B[B_WIDTH-1]}}, B};
        else
            assign bb = {{(Y_WIDTH - B_WIDTH){1'b0}}, B};
    endgenerate

    // a - b = a + ~b + 1.
    wire [Y_WIDTH-1:0] bb_inv = ~bb;

    // boot with ci=1 so majority(1 1 0)=1 and carry[0] starts set for the +1.
    wire boot_cout;
    wire boot_sumout;
    @ADDER_MODEL@ _boot (
        .a(1'b1), .b(1'b1), .cin(1'b0),
        .sumout(boot_sumout), .cout(boot_cout)
    );

    wire [Y_WIDTH:0] carry;
    assign carry[0] = boot_cout;

    genvar i;
    generate
        for (i = 0; i < Y_WIDTH; i = i + 1) begin : faChain
            @ADDER_MODEL@ _adder (
                .a     (aa[i]),
                .b     (bb_inv[i]),
                .cin   (carry[i]),
                .sumout(Y[i]),
                .cout  (carry[i+1])
            );
        end
    endgenerate

endmodule
