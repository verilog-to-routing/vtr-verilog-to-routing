// vtr_hardblock_lib.v -- generated by vtr_arch_rules from @ARCH_NAME@
// -lib stubs sized to the arch max port widths.
//
// primitive profiles (primitiveProfile in synthesis.tcl / arch_config.tcl):
//   vtr_classic         - standard multiply/adder/ram techmaps; stubs here
//                         only resolve rtl hierarchy before whitebox mapping
//   passthrough_exotics - stubAllHardblocks adds generic blackbox stubs for
//                         every exotic hardblock model (inserted below)
//
// +/parmys/vtr_primitives.v defaults to WIDTH=1 and -lib freezes that so
// write_blif would emit 1-bit blackboxes and leave the rest of the bus
// undriven. these stubs use the real max widths instead.
//
// ram stubs must be at least @RAM_STUB_DATA_WIDTH@ bits (widest arch bram data
// mode) so rtl instances resolve without truncating buses at read time.
// the whitebox later bit-slices them. keep the modules bodiless.
// titan soft-only arches override this file under <stem>/rules/ without
// the classic ram stubs.

@@HARDBLOCK_STUBS@@
(* blackbox *)
module @SP_RAM_MODEL@ #(
    parameter ADDR_WIDTH = 16,
    parameter DATA_WIDTH = @RAM_STUB_DATA_WIDTH@
) (
    input clk,
    input [ADDR_WIDTH-1:0] addr,
    input [DATA_WIDTH-1:0] data,
    input we,
    output [DATA_WIDTH-1:0] out
);
endmodule

(* blackbox *)
module @DP_RAM_MODEL@ #(
    parameter ADDR_WIDTH = 16,
    parameter DATA_WIDTH = @RAM_STUB_DATA_WIDTH@
) (
    input clk,
    input [ADDR_WIDTH-1:0] addr1,
    input [ADDR_WIDTH-1:0] addr2,
    input [DATA_WIDTH-1:0] data1,
    input [DATA_WIDTH-1:0] data2,
    input we1,
    input we2,
    output [DATA_WIDTH-1:0] out1,
    output [DATA_WIDTH-1:0] out2
);
endmodule

(* blackbox *)
module mux (
    input select,
    input x,
    input y,
    output z
);
endmodule

(* blackbox *)
module fpga_interconnect (
    input datain,
    output dataout
);
endmodule
