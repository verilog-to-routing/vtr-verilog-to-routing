// vtr_hardblock_lib.v. generated by vtr_arch_rules from @ARCH_NAME@
// these -lib stubs are sized to the arch max port widths.
//
// classic multiply/adder/ram stubs resolve rtl hierarchy before whitebox
// mapping. when stubAllHardblocks is on, generic blackbox stubs for every
// exotic hardblock model are inserted below as well.
//
// +/parmys/vtr_primitives.v defaults to WIDTH=1 and -lib freezes that default,
// so write_blif would emit 1-bit blackboxes and leave the rest of each bus
// undriven. these stubs use the real max widths instead.
//
// ram stubs must be at least @RAM_STUB_DATA_WIDTH@ bits wide (the widest arch
// bram data mode) so rtl instances resolve without truncating buses at read
// time while the whitebox later bit-slices them, and the modules stay bodiless.
// titan soft-only arches override this file under <stem>/rules/ without the
// classic ram stubs.

@@HARDBLOCK_STUBS@@
(* blackbox *)
module @SP_RAM_MODEL@ #(
    parameter ADDR_WIDTH = 16,
    parameter DATA_WIDTH = @RAM_STUB_DATA_WIDTH@
) (
    input clk,
    input [ADDR_WIDTH-1:0] addr,
    input [DATA_WIDTH-1:0] data,
    input we,
    output [DATA_WIDTH-1:0] out
);
endmodule

(* blackbox *)
module @DP_RAM_MODEL@ #(
    parameter ADDR_WIDTH = 16,
    parameter DATA_WIDTH = @RAM_STUB_DATA_WIDTH@
) (
    input clk,
    input [ADDR_WIDTH-1:0] addr1,
    input [ADDR_WIDTH-1:0] addr2,
    input [DATA_WIDTH-1:0] data1,
    input [DATA_WIDTH-1:0] data2,
    input we1,
    input we2,
    output [DATA_WIDTH-1:0] out1,
    output [DATA_WIDTH-1:0] out2
);
endmodule

(* blackbox *)
module mux (
    input select,
    input x,
    input y,
    output z
);
endmodule

(* blackbox *)
module fpga_interconnect (
    input datain,
    output dataout
);
endmodule
