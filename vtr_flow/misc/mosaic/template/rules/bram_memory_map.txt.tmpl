# bram_memory_map.txt. generated by vtr_arch_rules from @ARCH_NAME@
# this file feeds memory_libmap -lib under primitive profile vtr_classic. keep
# the wide widths because the bit-slice techmap needs more than 1-bit modes or
# every memory collapses to 32kx1 tiles. init zero is used because vtr
# single_port_ram and dual_port_ram blif blackboxes have no INIT parameter, so
# init any would map hard bram and then drop contents at techmap/write_blif;
# init zero keeps hard bram for undef/all-zero init (typical fpga power-up) and
# refuses non-zero init so those memories stay $mem and soft-map via memory_map
# (luts+ffs with init). rdwr old matches primitives.v non-blocking write then
# read (old-data / read-first) semantics for memory_libmap.
ram block $__VTR_SP_RAM__ {
  abits @SP_MAX_ABITS@;
  widths @SP_WIDTHS@ per_port;
  cost @SP_COST@;
  init zero;

  port srsw "A" {
    clock posedge;
    # old-data / read-first on same-address write+read in one cycle.
    rdwr old;
    wrtrans all old;
  }
}

ram block $__VTR_DP_RAM__ {
  abits @DP_MAX_ABITS@;
  widths @DP_WIDTHS@ per_port;
  cost @DP_COST@;
  init zero;

  # shared clock domain so both ports sit on one physical clock.
  port srsw "A" "B" {
    clock posedge "C";
    # old-data / read-first on same-address write+read in one cycle.
    rdwr old;
    wrtrans all old;
    optional_rw;
  }
}
