// multiply stub for vtr_classic -lib resolution; WIDTH defaults to the widest
// scanned mode so -lib does not freeze a 1-bit multiply.
(* blackbox *)
module @MULT_MODEL@ #(
    parameter WIDTH = @MULT_MAX_WIDTH@
) (
    input [WIDTH-1:0] a,
    input [WIDTH-1:0] b,
    output [2*WIDTH-1:0] out
);
endmodule
