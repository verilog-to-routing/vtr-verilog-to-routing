// mult_map.v. generated by vtr_arch_rules from @ARCH_NAME@
// MOSAIC_OVERLAY_MARKER min_exotic_integer_mul
// this map binds inferred $mul to the classic arch multiply model. it does not
// map onto exotic dsp cells. it must run before alumacc turns $mul into $macc and before
// generic techmap lowers $mul to gates. vpr picks the block mode from WIDTH so
// we select the smallest mode that still fits both extended operands, and signed
// ops need one extra sign bit that must still fit the widest mode or the map
// fails and leaves $mul soft. truncating the product to Y_WIDTH is fine because
// the $mul contract is the low bits. MULT_MIN_WIDTH keeps $mul soft when both
// operand widths are at or below the threshold.

module \$mul (A, B, Y);
    parameter A_SIGNED = 0;
    parameter B_SIGNED = 0;
    parameter A_WIDTH  = 1;
    parameter B_WIDTH  = 1;
    parameter Y_WIDTH  = 1;

    input  [A_WIDTH-1:0] A;
    input  [B_WIDTH-1:0] B;
    output [Y_WIDTH-1:0] Y;

    localparam AW_EXT = (A_SIGNED != 0) ? A_WIDTH + 1 : A_WIDTH;
    localparam BW_EXT = (B_SIGNED != 0) ? B_WIDTH + 1 : B_WIDTH;

    // fail when both operands are at or below MULT_MIN_WIDTH (0 disables).
    wire _TECHMAP_FAIL_ = (AW_EXT > @MULT_MAX_WIDTH@) || (BW_EXT > @MULT_MAX_WIDTH@)
                       || ((@MULT_MIN_WIDTH@ != 0) && (AW_EXT <= @MULT_MIN_WIDTH@) && (BW_EXT <= @MULT_MIN_WIDTH@));

    // clamp operand widths so wire decls stay legal even on the fail path.
    localparam AW = (AW_EXT > @MULT_MAX_WIDTH@) ? @MULT_MAX_WIDTH@ : AW_EXT;
    localparam BW = (BW_EXT > @MULT_MAX_WIDTH@) ? @MULT_MAX_WIDTH@ : BW_EXT;

    localparam MULT_W = @@MULT_TERNARY@@;

    wire [AW-1:0] a_ext;
    generate
        if (A_SIGNED)
            assign a_ext = {{(AW - A_WIDTH){A[A_WIDTH-1]}}, A};
        else
            assign a_ext = {{(AW - A_WIDTH){1'b0}}, A};
    endgenerate
    wire [MULT_W-1:0] aa = {{(MULT_W - AW){1'b0}}, a_ext};

    wire [BW-1:0] b_ext;
    generate
        if (B_SIGNED)
            assign b_ext = {{(BW - B_WIDTH){B[B_WIDTH-1]}}, B};
        else
            assign b_ext = {{(BW - B_WIDTH){1'b0}}, B};
    endgenerate
    wire [MULT_W-1:0] bb = {{(MULT_W - BW){1'b0}}, b_ext};

    wire [2*MULT_W-1:0] fullOut;

    @MULT_MODEL@ #(.WIDTH(MULT_W)) _TECHMAP_REPLACE_ (
        .a   (aa),
        .b   (bb),
        .out (fullOut)
    );

    assign Y = fullOut[Y_WIDTH-1:0];

endmodule
