# bram_memory_map.txt -- generated by vtr_arch_rules from @ARCH_NAME@
# fed to memory_libmap -lib. keep the wide widths  the bit-slice techmap
# needs more than 1-bit modes or every memory collapses to 32kx1 tiles.

ram block $__VTR_SP_RAM__ {
  abits @SP_MAX_ABITS@;
  widths @SP_WIDTHS@ per_port;
  cost @SP_COST@;
  init none;

  port srsw "A" {
    clock posedge;
    # undefined so both read-first and write-first $mem cells match. safe
    # when a memory never reads and writes the same address in one cycle.
    rdwr undefined;
    wrtrans all old;
  }
}

ram block $__VTR_DP_RAM__ {
  abits @DP_MAX_ABITS@;
  widths @DP_WIDTHS@ per_port;
  cost @DP_COST@;
  init none;

  # shared clock domain so both ports sit on one physical clock
  port srsw "A" "B" {
    clock posedge "C";
    rdwr undefined;
    wrtrans all old;
    optional_rw;
  }
}
