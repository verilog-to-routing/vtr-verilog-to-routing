# 20 independent carry chains of 12 full adders each, for the regression test of the
# dense (second) pass of initial placement (vtr_reg_strong/strong_dense_initial_placement).
#
# The adders of a chain are connected cout -> cin and share the chain's two primary inputs;
# only the last sum bit of each chain is a primary output. On arch/timing/soft_fpu_arch_timing_chain.xml
# each chain packs into a placement macro of 3 clb, so the 20 chains fill the 60 clb locations
# of its dense_initial_placement layout exactly.
.model adder_chains
.inputs a0 b0 a1 b1 a2 b2 a3 b3 a4 b4 a5 b5 a6 b6 a7 b7 a8 b8 a9 b9 a10 b10 a11 b11 a12 b12 a13 b13 a14 b14 a15 b15 a16 b16 a17 b17 a18 b18 a19 b19
.outputs s0 s1 s2 s3 s4 s5 s6 s7 s8 s9 s10 s11 s12 s13 s14 s15 s16 s17 s18 s19

.subckt adder a=a0 b=b0 cin=unconn cout=c0_0 sumout=s0_0
.subckt adder a=a0 b=b0 cin=c0_0 cout=c0_1 sumout=s0_1
.subckt adder a=a0 b=b0 cin=c0_1 cout=c0_2 sumout=s0_2
.subckt adder a=a0 b=b0 cin=c0_2 cout=c0_3 sumout=s0_3
.subckt adder a=a0 b=b0 cin=c0_3 cout=c0_4 sumout=s0_4
.subckt adder a=a0 b=b0 cin=c0_4 cout=c0_5 sumout=s0_5
.subckt adder a=a0 b=b0 cin=c0_5 cout=c0_6 sumout=s0_6
.subckt adder a=a0 b=b0 cin=c0_6 cout=c0_7 sumout=s0_7
.subckt adder a=a0 b=b0 cin=c0_7 cout=c0_8 sumout=s0_8
.subckt adder a=a0 b=b0 cin=c0_8 cout=c0_9 sumout=s0_9
.subckt adder a=a0 b=b0 cin=c0_9 cout=c0_10 sumout=s0_10
.subckt adder a=a0 b=b0 cin=c0_10 cout=c0_11 sumout=s0

.subckt adder a=a1 b=b1 cin=unconn cout=c1_0 sumout=s1_0
